---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found — Danny Silva | Personal Notebook" showNewsletter={false}>
    <main class="error-container">
        <div class="error-code">404</div>
        <div class="error-visual">
            <div class="error-circle"></div>
            <div class="error-circle"></div>
            <div class="error-circle"></div>
            <div class="error-face">&#x1F615;</div>
        </div>
        <h1 class="error-title">Page not found</h1>
        <p class="error-subtitle">The page you're looking for doesn't exist or has been moved. Let's get you back on track.</p>
        <div class="error-actions">
            <a href="/blog" class="btn-primary">Back to Blog</a>
            <a href="/" class="btn-secondary">Go Home</a>
        </div>
    </main>
</Layout>
