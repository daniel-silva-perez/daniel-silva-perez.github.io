---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title} description={post.data.description} activeNav="blog">
    <div class="reading-progress" id="readingProgress"></div>

    <article>
        <div class="post-hero">
            <span class="post-category">{post.data.category}</span>
            <h1 class="post-title">{post.data.title}</h1>
            <div class="post-meta">
                <span>Danny Silva</span>
                <span class="divider"></span>
                <span>{post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                <span class="divider"></span>
                <span>8 min read</span>
            </div>
        </div>

        <div class="post-layout">
            <aside>
                <button class="toc-mobile-toggle" id="tocToggle" onclick="toggleToc()">Table of Contents</button>
                <nav class="toc" id="toc">
                    <div class="toc-title">On this page</div>
                    <ul class="toc-list">
                        <li><a href="#introduction" class="active">Opening</a></li>
                        <li><a href="#the-problem-with-speed">The Problem with Speed</a></li>
                        <li><a href="#embracing-the-slow">Embracing the Slow</a></li>
                        <li><a href="#practical-steps">Practical Steps</a></li>
                        <li><a href="#conclusion">Conclusion</a></li>
                    </ul>
                </nav>
            </aside>

            <div class="post-content">
                {post.data.heroImage && <img src={post.data.heroImage} alt="" class="post-featured-image" />}
                <Content />
                <!-- Author Bio -->
                <div class="author-bio">
                    <div class="author-bio-avatar">DS</div>
                    <div class="author-bio-content">
                        <div class="author-bio-name">Danny Silva</div>
                        <div class="author-bio-role">Writer of a public notebook</div>
                        <p class="author-bio-text">I write here to keep track of what is moving through my mind: philosophy, art, attention, technology, books, and the work I am still learning how to do well.</p>
                    </div>
                </div>
            </div>
        </div>
    </article>

    <script is:inline src="/assets/js/post.js"></script>
</Layout>
