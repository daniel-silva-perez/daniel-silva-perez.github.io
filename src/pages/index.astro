---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Danny Silva | Notes on living, building, and paying attention." activeNav="home">
    <!-- ── HERO ── -->
    <section class="hero" id="top">
        <div class="hero-content">
            <div class="hero-label fade-up">Personal notebook</div>
            <h1 class="fade-up d1">Notes on living, building, and <em>paying attention.</em></h1>
            <p class="hero-desc fade-up d2">
                Life, essays, books, travel, and the occasional software note. I still build serious systems, but this site starts with the writing.
            </p>
            <div class="hero-buttons fade-up d3">
                <a href="/blog" class="btn btn-primary">Read the Writing
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3l5 5-5 5"/></svg>
                </a>
                <a href="/about" class="btn btn-ghost">About Me</a>
            </div>
            <div class="stats fade-up d4">
                <div class="stat"><div class="stat-num">Life</div><div class="stat-label">Notes</div></div>
                <div class="stat"><div class="stat-num">Books</div><div class="stat-label">Essays</div></div>
                <div class="stat"><div class="stat-num">Tech</div><div class="stat-label">Sometimes</div></div>
            </div>
        </div>
    </section>

    <!-- ── ABOUT ── -->
    <section id="about" class="about-section">
        <div class="section-header">
            <div class="section-label fade-up">About</div>
            <h2 class="fade-up d1">The person behind the notes</h2>
        </div>
        <div class="about-content">
            <p class="fade-up d2">
                I'm <strong>Danny</strong>. I write about the ordinary stuff that keeps becoming important: routines, books, travel, attention, ambition, and what it means to build a life while building software.
            </p>
            <p class="fade-up d3">
                The software work is still here, but it is no longer the whole front door. It lives beside the personal writing as one part of a wider notebook.
            </p>
            <p class="fade-up d4">
                If you are here for the human side, start with the writing.
            </p>
        </div>
    </section>

</Layout>
