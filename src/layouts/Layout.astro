---
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description?: string;
  activeNav?: string;
  image?: string;
  pubDate?: Date;
  updatedDate?: Date;
  type?: 'website' | 'article';
}

const { title, description = "Danny Silva's public notebook for thoughts on philosophy, art, technology, attention, what he is building, and what he is reading.", activeNav, image, pubDate, updatedDate, type } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <SEO title={title} description={description} image={image} pubDate={pubDate} updatedDate={updatedDate} type={type} />
    <script is:inline src="/assets/js/theme.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
    <nav>
        <a class="nav-logo" href="/">Danny<span>.</span></a>
        <button class="mobile-toggle" onclick="document.querySelector('.nav-links').classList.toggle('open'); this.setAttribute('aria-expanded', document.querySelector('.nav-links').classList.contains('open'))" aria-label="Toggle menu" aria-expanded="false" aria-controls="siteNav">&#9776;</button>
        <ul class="nav-links" id="siteNav">
            <li><a href="/blog" class={activeNav === 'blog' ? 'active' : ''}>Notebook</a></li>
            <li><a href="/archive" class={activeNav === 'archive' ? 'active' : ''}>Archive</a></li>
            <li><a href="/tags" class={activeNav === 'tags' ? 'active' : ''}>Tags</a></li>
            <li><a href="/about" class={activeNav === 'about' ? 'active' : ''}>About</a></li>
            <li><a href="/" class={activeNav === 'home' ? 'active' : ''}>Home</a></li>
            <li class="nav-controls">
                <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode" title="Toggle dark mode">
                    <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                    <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21(3 7 7 0 0 0 21 12.79z"/></svg>
                </button>
                <button class="case-toggle" id="caseToggle" aria-label="Toggle lowercase" aria-pressed="false" title="Toggle lowercase">
                    Aa
                </button>
            </li>
        </ul>
    </nav>

    <slot />

    <footer>
        <div class="footer-links">
            <a href="/blog">Notebook</a>
            <a href="/archive">Archive</a>
            <a href="/tags">Tags</a>
            <a href="/about">About</a>
            <a href="/">Home</a>
        </div>
        <p class="footer-copyright">&copy; 2026 Danny Silva. Notes from a mind in progress.</p>
    </footer>

    <button class="back-to-top" id="backToTop" aria-label="Back to top">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 15l-6-6-6 6"/>
        </svg>
    </button>

    <script is:inline src="/assets/js/main.js"></script>
</body>
</html>
