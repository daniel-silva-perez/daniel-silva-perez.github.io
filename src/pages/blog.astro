---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getReadingTime } from '../utils/readingTime';
import { formatDate } from '../utils/formatDate';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = posts[0];
const otherPosts = posts.slice(1);

const categoryCounts = posts.reduce((acc, post) => {
	const cat = post.data.category || 'Uncategorized';
	acc[cat] = (acc[cat] || 0) + 1;
	return acc;
}, {} as Record<string, number>);
---

<Layout title="Blog — Danny Silva" activeNav="blog">
    <div class="scroll-progress" id="scrollProgress"></div>

    {featuredPost && (
    <section class="blog-hero">
        <a href={`/blog/${featuredPost.slug}`} class="hero-card">
            {featuredPost.data.heroImage && <img src={featuredPost.data.heroImage} alt={featuredPost.data.title} decoding="async" fetchpriority="high">}
            <div class="hero-overlay">
                <span class="hero-category">Featured</span>
                <h1 class="hero-title">{featuredPost.data.title}</h1>
                <p class="hero-excerpt">{featuredPost.data.description}</p>
                <div class="hero-meta">
                    <span>Danny Silva</span>
                    <span class="dot"></span>
                    <span>{formatDate(featuredPost.data.pubDate)}</span>
                    <span class="dot"></span>
                    <span>{getReadingTime(featuredPost.body)}</span>
                </div>
            </div>
        </a>
    </section>
    )}

    <section class="categories-section">
        <div class="categories-header">
            <h2 class="categories-title">Posts on philosophy, art, books, technology, and whatever is occupying my attention</h2>
        </div>
        <div class="categories-scroll">
            <a href="/tags" class="category-chip">
                <span class="category-chip-name">All</span>
                <span class="category-chip-count">{posts.length} posts</span>
            </a>
            {Object.entries(categoryCounts).map(([cat, count]) => (
            <a href="/tags" class="category-chip">
                <span class="category-chip-name">{cat}</span>
                <span class="category-chip-count">{count} post{count === 1 ? '' : 's'}</span>
            </a>
            ))}
        </div>
    </section>

    <h2 class="section-title">Latest Posts</h2>

    <section class="posts-grid">
        {otherPosts.map((post) => (
        <article class="post-card" onclick={`location.href='/blog/${post.slug}'`}>
            <div class="post-card-image">
                {post.data.heroImage && <img src={post.data.heroImage} alt={post.data.title} loading="lazy" decoding="async">}
            </div>
            <div class="post-card-content">
                <span class={`post-card-category ${post.data.category === 'Tech' ? 'tech-label' : ''}`}>{post.data.category}</span>
                <h3 class="post-card-title">{post.data.title}</h3>
                <p class="post-card-excerpt">{post.data.description}</p>
                <div class="post-card-footer">
                    <div class="post-card-author">
                        <div class="author-avatar">DS</div>
                        <span class="author-name">Danny Silva</span>
                    </div>
                    <div class="post-card-meta">
                        <span>{formatDate(post.data.pubDate)}</span>
                        <span class="reading-time">{getReadingTime(post.body)}</span>
                    </div>
                </div>
            </div>
        </article>
        ))}
    </section>

    <script is:inline src="/assets/js/blog.js"></script>
</Layout>
