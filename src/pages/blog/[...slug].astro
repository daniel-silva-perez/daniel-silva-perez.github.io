---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getReadingTime } from '../../utils/readingTime';
import { formatDate } from '../../utils/formatDate';

export async function getStaticPaths() {
	const posts = (await getCollection('blog'))
		.filter((post) => !post.data.draft)
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
	return posts.map((post, idx) => ({
		params: { slug: post.slug },
		props: {
			post,
			// posts are sorted newest→oldest, so newer = idx-1, older = idx+1
			newer: posts[idx - 1] ?? null,
			older: posts[idx + 1] ?? null,
		},
	}));
}
type Props = {
	post: CollectionEntry<'blog'>;
	newer: CollectionEntry<'blog'> | null;
	older: CollectionEntry<'blog'> | null;
};

const { post, newer, older } = Astro.props;
const { Content, headings } = await post.render();
---

<Layout
	title={post.data.title}
	description={post.data.description}
	activeNav="blog"
	image={post.data.heroImage}
	pubDate={post.data.pubDate}
	updatedDate={post.data.updatedDate}
	type="article"
>
    <div class="reading-progress" id="readingProgress"></div>

    <article>
        <div class="post-hero">
            <span class="post-category">{post.data.category}</span>
            <h1 class="post-title">{post.data.title}</h1>
            <div class="post-meta">
                <span>Danny Silva</span>
                <span class="divider"></span>
                <span>{formatDate(post.data.pubDate)}</span>
                {post.data.updatedDate && (
                  <>
                    <span class="divider"></span>
                    <span>Updated {formatDate(post.data.updatedDate)}</span>
                  </>
                )}
                <span class="divider"></span>
                <span>{getReadingTime(post.body)}</span>
            </div>
        </div>

        <div class="post-layout">
            <aside>
                {headings.length > 0 && (
                <>
                <button class="toc-mobile-toggle" id="tocToggle" onclick="toggleToc()">Table of Contents</button>
                <nav class="toc" id="toc">
                    <div class="toc-title">On this page</div>
                    <ul class="toc-list">
                        {headings.filter((h) => h.depth <= 3).map((h) => (
                        <li><a href={`#${h.slug}`}>{h.text}</a></li>
                        ))}
                    </ul>
                </nav>
                </>
                )}
            </aside>

            <div class="post-content">
                {post.data.heroImage && <img src={post.data.heroImage} alt="" class="post-featured-image" decoding="async" fetchpriority="high" />}
                <Content />
                <!-- Author Bio -->
                <div class="author-bio">
                    <div class="author-bio-avatar">DS</div>
                    <div class="author-bio-content">
                        <div class="author-bio-name">Danny Silva</div>
                        <div class="author-bio-role">Writer of a personal blog</div>
                        <p class="author-bio-text">I write here to keep track of what is moving through my mind: philosophy, art, attention, technology, books, and the work I am still learning how to do well.</p>
                    </div>
                </div>

                <p class="reply-link">
                    Have a thought on this? <a href={`mailto:danielsilvaperez24@gmail.com?subject=${encodeURIComponent('Re: ' + post.data.title)}`}>Reply by email</a>.
                </p>

                {(newer || older) && (
                <nav class="post-pager" aria-label="Post navigation">
                    {older ? (
                        <a class="pager-link prev" href={`/blog/${older.slug}`} rel="prev">
                            <span class="pager-label">← Older</span>
                            <span class="pager-title">{older.data.title}</span>
                        </a>
                    ) : <span></span>}
                    {newer ? (
                        <a class="pager-link next" href={`/blog/${newer.slug}`} rel="next">
                            <span class="pager-label">Newer →</span>
                            <span class="pager-title">{newer.data.title}</span>
                        </a>
                    ) : <span></span>}
                </nav>
                )}
            </div>
        </div>
    </article>

    <script is:inline src="/assets/js/post.js"></script>
</Layout>
