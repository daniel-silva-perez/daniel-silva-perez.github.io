---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getReadingTime } from '../utils/readingTime';
import { formatDate } from '../utils/formatDate';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [...new Set(posts.map((p) => p.data.category).filter(Boolean))];
---

<Layout title="Archive — Danny Silva | Blog" activeNav="archive">
    <main>
        <section class="archive-hero">
            <h1 class="archive-title">Archive</h1>
            <p class="archive-subtitle">A record of the thoughts I have kept: philosophy, art, books, technology, life, and work in progress.</p>

            <div class="category-filter">
                <button class="category-btn active" data-category="all">All Posts</button>
                {categories.map((cat) => (
                <button class="category-btn" data-category={cat?.toLowerCase()}>{cat}</button>
                ))}
            </div>
        </section>

        <section class="archive-content">
            <div class="posts-list">
                {posts.map((post) => (
                <article class="post-row" data-category={post.data.category?.toLowerCase()} onclick={`location.href='/blog/${post.id}'`}>
                    <div class="post-row-image">
                        {post.data.heroImage && <img src={post.data.heroImage} alt={post.data.title} loading="lazy" decoding="async">}
                    </div>
                    <div class="post-row-content">
                        <div class="post-row-meta">
                            <span class={`post-tag ${post.data.category === 'Tech' ? 'tech-label' : ''}`}>{post.data.category}</span>
                            <span class="post-date">{formatDate(post.data.pubDate)}</span>
                        </div>
                        <h3 class="post-row-title">{post.data.title}</h3>
                        <p class="post-row-excerpt">{post.data.description}</p>
                        <div class="post-row-author">
                            <div class="author-avatar">DS</div>
                            <span class="author-name">Danny Silva</span>
                            <span class="read-time">{getReadingTime(post.body)}</span>
                        </div>
                    </div>
                </article>
                ))}
            </div>
        </section>
    </main>

    <script is:inline src="/assets/js/archive.js"></script>
</Layout>
