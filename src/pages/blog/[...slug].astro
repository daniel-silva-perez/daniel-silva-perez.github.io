---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getReadingTime } from '../../utils/readingTime';
import { formatDate } from '../../utils/formatDate';

export async function getStaticPaths() {
	const posts = (await getCollection('blog'))
		.filter((post) => !post.data.draft)
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
	return posts.map((post, idx) => {
		const related = posts
			.filter((p) => p.slug !== post.slug)
			.map((p) => {
				const sharedTags = p.data.tags.filter((t) => post.data.tags.includes(t)).length;
				const sameCat = p.data.category && p.data.category === post.data.category ? 1 : 0;
				return { post: p, score: sharedTags * 2 + sameCat };
			})
			.filter((r) => r.score > 0)
			.sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
			.slice(0, 3)
			.map((r) => r.post);
		return {
			params: { slug: post.slug },
			props: {
				post,
				newer: posts[idx - 1] ?? null,
				older: posts[idx + 1] ?? null,
				related,
			},
		};
	});
}
type Props = {
	post: CollectionEntry<'blog'>;
	newer: CollectionEntry<'blog'> | null;
	older: CollectionEntry<'blog'> | null;
	related: CollectionEntry<'blog'>[];
};

const { post, newer, older, related } = Astro.props;
const { Content, headings } = await post.render();
---

<Layout
	title={post.data.title}
	description={post.data.description}
	activeNav="blog"
	image={post.data.heroImage}
	pubDate={post.data.pubDate}
	updatedDate={post.data.updatedDate}
	type="article"
>
    <div class="reading-progress" id="readingProgress"></div>

    <article>
        <div class="post-hero">
            <span class="post-category">{post.data.category}</span>
            <h1 class="post-title">{post.data.title}</h1>
            <div class="post-meta">
                <span>Danny Silva</span>
                <span class="divider"></span>
                <span>{formatDate(post.data.pubDate)}</span>
                {post.data.updatedDate && (
                  <>
                    <span class="divider"></span>
                    <span>Updated {formatDate(post.data.updatedDate)}</span>
                  </>
                )}
                <span class="divider"></span>
                <span>{getReadingTime(post.body)}</span>
                <span class="divider"></span>
                <button id="ttsToggle" class="tts-control" data-state="idle" type="button" aria-label="Read aloud" aria-pressed="false">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5L6 9H2v6h4l5 4z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
                    <span class="tts-label">Listen</span>
                </button>
                <button id="ttsStop" class="tts-control tts-stop" type="button" aria-label="Stop reading" hidden>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1"/></svg>
                </button>
            </div>
        </div>

        <div class="post-layout">
            <aside>
                {headings.length > 0 && (
                <>
                <button class="toc-mobile-toggle" id="tocToggle" onclick="toggleToc()">Table of Contents</button>
                <nav class="toc" id="toc">
                    <div class="toc-title">On this page</div>
                    <ul class="toc-list">
                        {headings.filter((h) => h.depth <= 3).map((h) => (
                        <li><a href={`#${h.slug}`}>{h.text}</a></li>
                        ))}
                    </ul>
                </nav>
                </>
                )}
            </aside>

            <div class="post-content">
                {post.data.heroImage && <img src={post.data.heroImage} alt="" class="post-featured-image" decoding="async" fetchpriority="high" />}
                <Content />
                <!-- Author Bio -->
                <div class="author-bio">
                    <div class="author-bio-avatar">DS</div>
                    <div class="author-bio-content">
                        <div class="author-bio-name">Danny Silva</div>
                        <div class="author-bio-role">Writer of a personal blog</div>
                        <p class="author-bio-text">I write here to keep track of what is moving through my mind: philosophy, art, attention, technology, books, and the work I am still learning how to do well.</p>
                    </div>
                </div>

                <p class="reply-link">
                    Have a thought on this? <a href={`mailto:danielsilvaperez24@gmail.com?subject=${encodeURIComponent('Re: ' + post.data.title)}`}>Reply by email</a>.
                </p>

                {related.length > 0 && (
                <section class="related-posts">
                    <h2 class="related-posts-title">Related posts</h2>
                    <div class="posts-grid">
                        {related.map((p) => <PostCard post={p} />)}
                    </div>
                </section>
                )}

                {(newer || older) && (
                <nav class="post-pager" aria-label="Post navigation">
                    {older ? (
                        <a class="pager-link prev" href={`/blog/${older.slug}`} rel="prev">
                            <span class="pager-label">← Older</span>
                            <span class="pager-title">{older.data.title}</span>
                        </a>
                    ) : <span></span>}
                    {newer ? (
                        <a class="pager-link next" href={`/blog/${newer.slug}`} rel="next">
                            <span class="pager-label">Newer →</span>
                            <span class="pager-title">{newer.data.title}</span>
                        </a>
                    ) : <span></span>}
                </nav>
                )}
            </div>
        </div>
    </article>

    <script is:inline src="/assets/js/post.js"></script>
</Layout>
