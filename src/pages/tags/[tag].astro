---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  const tagMap = new Map<string, CollectionEntry<'blog'>[]>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!tagMap.has(tag)) tagMap.set(tag, []);
      tagMap.get(tag)!.push(post);
    }
  }
  return Array.from(tagMap.entries()).map(([tag, tagPosts]) => ({
    params: { tag },
    props: {
      tag,
      posts: tagPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

type Props = { tag: string; posts: CollectionEntry<'blog'>[] };
const { tag, posts } = Astro.props;
---
<Layout title={`#${tag} — Danny Silva | Blog`} activeNav="tags">
  <main>
    <section class="tags-hero">
      <p class="tags-subtitle"><a href="/tags">← All tags</a></p>
      <h1 class="tags-title">#{tag}</h1>
      <p class="tags-subtitle">{posts.length} post{posts.length === 1 ? '' : 's'}</p>
    </section>
    <section class="posts-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </section>
  </main>
</Layout>
